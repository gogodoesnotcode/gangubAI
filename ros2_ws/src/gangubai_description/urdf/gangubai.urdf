<?xml version="1.0"?>
<robot name="gangubai">

  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  
    <link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0.05" rpy="0 0 0"/> </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.2 0.15 0.05"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.2 0.15 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <link name="front_left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel"/>
    <origin xyz="0.07 0.1 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel"/>
    <origin xyz="0.07 -0.1 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="back_left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="back_left_wheel"/>
    <origin xyz="-0.07 0.1 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="back_right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder length="0.04" radius="0.03"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="back_right_wheel"/>
    <origin xyz="-0.07 -0.1 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="ir_sensor_front">
    <visual><geometry><sphere radius="0.01"/></geometry></visual>
    <collision><geometry><sphere radius="0.005"/></geometry></collision> <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="ir_joint" type="fixed">
  <parent link="base_link"/>
  <child link="ir_sensor_front"/>
  <origin xyz="0.12 0 -0.01" rpy="0 1.5708 0"/>
</joint>

<link name="optical_sensor_link">
    <visual>
      <geometry><box size="0.01 0.01 0.01"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="optical_joint" type="fixed">
    <parent link="base_link"/>
    <child link="optical_sensor_link"/>
    <origin xyz="0 0 -0.025" rpy="0 1.5708 0"/> 
  </joint>

  <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <wheel_separation>0.2</wheel_separation>
      <wheel_diameter>0.06</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_wheel_tf>true</publish_wheel_tf>
      <publish_distance>true</publish_distance>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
  <gazebo reference="ir_sensor_front">
  <sensor type="ray" name="cliff_sensor">
    <pose>0 0 0 0 0 0</pose>
    <visualize>true</visualize> <update_rate>10</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.01</min>
        <max>0.2</max>
        <resolution>0.01</resolution>
      </range>
    </ray>
    <plugin name="cliff_sensor_plugin" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <remapping>~/out:=cliff_data</remapping>
      </ros>
      <output_type>sensor_msgs/Range</output_type>
      <frame_name>ir_sensor_front</frame_name>
    </plugin>
  </sensor>
</gazebo>
<gazebo reference="optical_sensor_link">
    <sensor type="camera" name="optical_flow_sensor">
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>0.5</horizontal_fov> <image>
          <width>64</width>
          <height>64</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>1.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=optical_flow/image</remapping>
        </ros>
        <frame_name>optical_sensor_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>